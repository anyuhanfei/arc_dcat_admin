APP_NAME=ARC_DCAT_ADMIN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ADMIN_HTTPS=false

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arc_dcat_admin
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 邮件配置
# MAIL_MAILER 可选值：log(开发调试，邮件写入 storage/logs/laravel.log 不真实发送) / smtp(真实发送)
MAIL_MAILER=log
# 发送加密方式：smtps(465端口SSL加密，163/126/QQ常用) / smtp(STARTTLS或明文) / 留空(明文)
# ⚠️ 注意：不支持 ssl 这个值！写成 ssl 会报 UnsupportedSchemeException 导致邮件发送失败（表现为「邮件发送失败，请稍后重试」）
MAIL_SCHEME=null
# SMTP 服务器：163=smtp.163.com / 126=smtp.126.com / QQ=smtp.qq.com
MAIL_HOST=127.0.0.1
# SMTP 端口：465(SSL，配合 smtps) / 25(明文)
MAIL_PORT=2525
# 邮箱账号：填完整邮箱地址（如 xxx@163.com）
MAIL_USERNAME=null
# ⚠️ 不是邮箱登录密码！需在邮箱网页端「设置 → POP3/SMTP/IMAP」开启 SMTP 服务后，用短信验证生成的「授权码」（约16位，仅显示一次）填入
MAIL_PASSWORD=null
# 发件人地址：必须与 MAIL_USERNAME 是同一个邮箱（163/126 不允许 FROM 冒充其他发件人）
MAIL_FROM_ADDRESS="hello@example.com"
# 发件人显示名称（可自定义）
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# 短信配置
SMS_DRIVER=smsbao
# 短信宝配置
SMSBAO_USERNAME=
SMSBAO_PASSWORD=
SMSBAO_SIGN=你的签名
# 阿里云短信配置
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=

# ============ 云存储（无OSS / 腾讯云COS / 阿里云OSS 切换）============
# CLOUD_DRIVER: none=本地存储 | cos=腾讯云COS | aliyun=阿里云OSS
CLOUD_DRIVER=none

# 上传限制（单文件 MB）
UPLOAD_MAX_SIZE_MB=100
# ffmpeg 可执行文件路径（视频截帧用，无视频上传需求可忽略）
FFMPEG_BIN=/usr/local/bin/ffmpeg

# 腾讯云 COS（CLOUD_DRIVER=cos 时填写，密钥留空）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-beijing
COS_BUCKET=
COS_DOMAIN=
COS_PREFIX=

# 阿里云 OSS（CLOUD_DRIVER=aliyun 时填写，密钥留空）
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_DOMAIN=
ALIYUN_OSS_PREFIX=

# 微信登录配置（未配置时调用对应接口会抛业务异常）
WX_MINI_APPID=
WX_MINI_SECRET=
WX_MP_APPID=
WX_MP_SECRET=
WX_APP_APPID=
WX_APP_SECRET=

# Apple 登录配置（Sign in with Apple，iOS/Web）
APPLE_CLIENT_ID=
# 易盾一键登录配置（本机号码校验）
YIDUN_SECRET_ID=
YIDUN_BUSINESS_ID=
YIDUN_SECRET_KEY=
